# Copy this file to `.env` in the same folder and fill in your keys.
# A `.env` takes effect immediately - unlike Windows `setx`, which only
# affects terminals you open AFTERWARDS.
#
# Or let the CLI write it for you:
#     realme key GEMINI_API_KEY your-key-here

# Free from https://aistudio.google.com - writes the narration.
GEMINI_API_KEY=

# Optional: your cloned voice. Without these you get a placeholder voice,
# which is fine for checking that the script reads well.
ELEVENLABS_API_KEY=
REALME_ELEVEN_VOICE_ID=

# Optional: Google Chirp 3 Instant Custom Voice instead of ElevenLabs.
REALME_GOOGLE_VOICE_KEY=

# Optional: where projects, profile and renders are kept.
# Defaults to ~/RealMeStudio  (C:\Users\<you>\RealMeStudio on Windows).
# REALME_HOME=C:\Users\<you>\Documents\RealMe\_data
